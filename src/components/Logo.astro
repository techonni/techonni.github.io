---
interface Props {
  size?: number;
  class?: string;
}

const { size = 40, class: className = '' } = Astro.props;
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 40 40"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
>
  <circle cx="20" cy="8" r="2.2" fill="currentColor" />
  <circle cx="28.5" cy="11.5" r="2.2" fill="currentColor" />
  <circle cx="32" cy="20" r="2.2" fill="currentColor" />
  <circle cx="28.5" cy="28.5" r="2.2" fill="currentColor" />
  <circle cx="20" cy="32" r="2.2" fill="currentColor" />
  <circle cx="11.5" cy="28.5" r="2.2" fill="currentColor" />
  <circle cx="8" cy="20" r="2.2" fill="currentColor" />
  <circle cx="11.5" cy="11.5" r="2.2" fill="currentColor" />
  <circle cx="20" cy="20" r="2.6" fill="currentColor" />
</svg>
